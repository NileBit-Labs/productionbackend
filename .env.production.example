APP_NAME="NileBit POS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.nilebitlabs.com
FRONTEND_URL=https://pos.nilebitlabs.com
LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DATABASE_URL=
DB_SSLMODE=require

CORS_ALLOWED_ORIGINS=https://pos.nilebitlabs.com,https://nilebitlabs.com
PUBLIC_REGISTRATION=false
# Set true only for Render's free public-beta deployment. Paid deployments use a pre-deploy migration.
RUN_MIGRATIONS_ON_BOOT=false
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=database
QUEUE_FAILED_DRIVER=database-uuids
FILESYSTEM_DISK=local

# Transactional password-reset mail. Brevo's SMTP free tier is suitable for beta; use a verified
# sender/domain and set the three blank values as production secrets/settings, never in git.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_TIMEOUT=10
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_REASONING_EFFORT=none
GROQ_REASONING_FORMAT=hidden
ASK_DAILY_LIMIT=200
